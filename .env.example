# ==========================================
# Forensic Audio Analysis Suite — Configuration
# ==========================================

# Backend Settings (Optional overrides)
# Database URL (SQLite default: sqlite:///forensic.db)
# For PostgreSQL: postgresql://faa:faa@localhost:5432/forensics
FAA_DATABASE_URL=sqlite:///backend/forensic.db

# Max upload size in Megabytes
FAA_MAX_UPLOAD_MB=500

# Frontend Settings (Vite)
# Port for backend proxy in development (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000
