{
  "name": "audio-forensics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && python3 -m pip install -r backend/requirements.txt",
    "setup:ml": "npm install && ./scripts/install_ml.sh",
    "dev": "concurrently -n \"api,ui\" -c \"blue,green\" \"python3 -m uvicorn backend.app.main:app --reload --port 8000\" \"vite\"",
    "dev:ui": "vite",
    "dev:backend": "python3 -m uvicorn backend.app.main:app --reload --port 8000",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "python3 -m pytest backend/tests -v"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "vite": "^5.4.11"
  }
}
